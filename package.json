{
  "name": "mizan-reconciliation",
  "version": "0.4.39",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-ocr-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr-assets.mjs && vite build --configLoader runner && node scripts/harden-build.mjs",
    "start": "vite preview --host 127.0.0.1",
    "lint": "node scripts/lint-check.mjs",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node --experimental-strip-types scripts/prepare-browser-fixtures.mjs && node --experimental-strip-types scripts/browser-test.mjs",
    "test:browser:main-integration": "node --experimental-strip-types scripts/supplier-main-overlap-browser.mjs",
    "test:browser:startup-readiness": "node scripts/startup-readiness-browser.mjs",
    "test:browser:domain-navigation": "node scripts/domain-navigation-browser.mjs",
    "test:browser:reconciliation-entry": "node scripts/reconciliation-entry-browser.mjs",
    "test:browser:section-families": "node --experimental-strip-types scripts/section-families-browser.mjs",
    "test:browser:section-currency": "node --experimental-strip-types scripts/section-qualified-currency-browser.mjs",
    "test:browser:performance": "node scripts/performance-check.mjs",
    "test:mutations": "node scripts/test-mutations.mjs && node scripts/test-source-display-faults.mjs",
    "test:source-display-faults": "node scripts/test-source-display-faults.mjs",
    "test:mutation-runner": "node --test scripts/mutation-runner-support.test.mjs scripts/specialized-faults.test.mjs scripts/package-commands.test.mjs",
    "test:specialized-faults": "node scripts/test-specialized-faults.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:mutation-runner && pnpm test:mutations && pnpm test:specialized-faults && pnpm build && pnpm test:browser && pnpm test:browser:startup-readiness && pnpm test:browser:main-integration && pnpm test:browser:section-families && pnpm test:browser:section-currency && pnpm test:browser:domain-navigation && pnpm test:browser:reconciliation-entry",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "brand:social": "node scripts/generate-social-assets.mjs",
    "test:reliability:quick": "node --experimental-strip-types audit/reliability/run.mjs --quick",
    "test:reliability:p2": "node scripts/test-p2-contracts.mjs",
    "test:reliability:partial": "node scripts/test-partial-contracts.mjs",
    "test:reliability": "node --experimental-strip-types audit/reliability/run.mjs --split development,validation,final --frozen",
    "test:reliability:development": "node --experimental-strip-types audit/reliability/run.mjs",
    "test:reliability:performance": "node scripts/performance-check.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "exceljs": "4.4.0",
    "input-otp": "1.4.2",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "saxes": "5.0.1",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
