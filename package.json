{
  "name": "mizan-reconciliation",
  "version": "0.4.7",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-ocr-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-ocr-assets.mjs && vite build && node scripts/harden-build.mjs",
    "start": "vite preview --host 127.0.0.1",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-test.mjs",
    "test:browser:performance": "node --experimental-strip-types scripts/browser-performance.mjs",
    "test:mutations": "node scripts/test-mutations.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm test:mutations && pnpm build && pnpm test:browser",
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "test:reliability:quick": "node --experimental-strip-types audit/reliability/run.mjs --quick",
    "test:reliability": "node --experimental-strip-types audit/reliability/run.mjs --split development,validation,final --frozen",
    "test:reliability:development": "node --experimental-strip-types audit/reliability/run.mjs",
    "test:reliability:performance": "node --experimental-strip-types audit/reliability/performance.mjs --sizes=100,1000,5000,20000"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "exceljs": "4.4.0",
    "input-otp": "1.4.2",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "saxes": "5.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
