+import type { Matrix } from './pdf-glyph-geometry.ts';
+
+// A glyph's ink box is a bound, not its ink: two boxes from neighbouring lines
+// can overlap at their corners while the letters inside them stay apart
+// (BNK-PDF-1 G10, P09). Where the row test finds two such boxes, the outlines
+// themselves decide. An outline is flattened on the page with a known bound on
+// how far its chords leave its curves, and two glyphs are apart only when no
+// edge of one comes within those bounds and a margin of an edge of the other,
+// and neither encloses a point of the other. Anything unknown, unreadable or
+// beyond the budget is never apart.
+
+const PATH_POINTS = [2, 2, 6, 4, 0];
+const MOVE = 0,
+  CLOSE = 4;
+/** Chords per curve at most; the bound then says how far they stray. */
+const MAX_CHORDS = 256;
+
+export type GlyphShape = {
+  /** Closed polygons on the page, x0, y0, x1, y1, ... */
+  contours: number[][];
+  /** How far a chord can be from the curve it replaces. */
+  error: number;
+  box: [number, number, number, number];
+};
+
+/** A glyph outline (PDF.js FontPath, per unit font size) carried onto the page
+ * by the glyph's matrix, as closed polygons within `tolerance` of its curves. */
+export function glyphShape(
+  path: unknown,
+  m: Matrix,
+  tolerance: number,
+): GlyphShape | undefined {
+  if (!(path instanceof ArrayBuffer) || !(tolerance > 0)) return undefined;
+  // Decoded as PDF.js encodes it in this realm, as the outline reader does.
+  const Values =
+    typeof Float16Array === 'undefined' ? Float32Array : Float16Array;
+  if (path.byteLength % Values.BYTES_PER_ELEMENT) return undefined;
+  const values = new Values(path);
+  const place = (x: number, y: number) => [
+    m[0] * x + m[2] * y + m[4],
+    m[1] * x + m[3] * y + m[5],
+  ];
+  const contours: number[][] = [];
+  let contour: number[] = [],
+    start: number[] | undefined,
+    error = 0;
+  const finish = () => {
+    if (contour.length >= 4) contours.push(contour);
+    contour = [];
+  };
+  for (let i = 0; i < values.length;) {
+    const op = values[i++],
+      size = PATH_POINTS[op];
+    if (size === undefined || i + size > values.length) return undefined;
+    const raw = Array.from(values.subarray(i, i + size));
+    i += size;
+    if (!raw.every(Number.isFinite)) return undefined;
+    if (op === CLOSE) {
+      finish();
+      if (start) contour = [...start];
+      continue;
+    }
+    const points: number[][] = [];
+    for (let k = 0; k < size; k += 2) points.push(place(raw[k], raw[k + 1]));
+    if (op === MOVE) {
+      finish();
+      start = points[0];
+      contour = [...start];
+      continue;
+    }
+    // A segment needs a point to start from.
+    if (contour.length < 2) return undefined;
+    if (points.length === 1) {
+      contour.push(...points[0]);
+      continue;
+    }
+    const p = [contour.slice(-2), ...points];
+    // The second differences bound the curvature, and so the chord error.
+    const second = (k: number) =>
+      Math.hypot(
+        p[k][0] - 2 * p[k + 1][0] + p[k + 2][0],
+        p[k][1] - 2 * p[k + 1][1] + p[k + 2][1],
+      );
+    const reach =
+      p.length === 4 ? 0.75 * Math.max(second(0), second(1)) : 0.25 * second(0);
+    const chords = Math.min(
+      MAX_CHORDS,
+      Math.max(1, Math.ceil(Math.sqrt(reach / tolerance))),
+    );
+    error = Math.max(error, reach / (chords * chords));
+    for (let k = 1; k <= chords; k++) {
+      const t = k / chords,
+        u = 1 - t;
+      const w =
+        p.length === 4
+          ? [u * u * u, 3 * u * u * t, 3 * u * t * t, t * t * t]
+          : [u * u, 2 * u * t, t * t];
+      contour.push(
+        w.reduce((s, c, j) => s + c * p[j][0], 0),
+        w.reduce((s, c, j) => s + c * p[j][1], 0),
+      );
+    }
+  }
+  finish();
+  if (!contours.length) return undefined;
+  let x0 = Infinity,
+    y0 = Infinity,
+    x1 = -Infinity,
+    y1 = -Infinity;
+  for (const c of contours)
+    for (let k = 0; k < c.length; k += 2) {
+      x0 = Math.min(x0, c[k]);
+      x1 = Math.max(x1, c[k]);
+      y0 = Math.min(y0, c[k + 1]);
+      y1 = Math.max(y1, c[k + 1]);
+    }
+  if (![x0, y0, x1, y1, error].every(Number.isFinite)) return undefined;
+  return { contours, error, box: [x0, y0, x1, y1] };
+}
+
+/** The nonzero winding number of a shape around a point. */
+function winding(shape: GlyphShape, x: number, y: number) {
+  let wound = 0;
+  for (const c of shape.contours)
+    for (let k = 0; k < c.length; k += 2) {
+      const ax = c[k],
+        ay = c[k + 1],
+        bx = c[(k + 2) % c.length],
+        by = c[(k + 3) % c.length];
+      const side = (bx - ax) * (y - ay) - (x - ax) * (by - ay);
+      if (ay <= y && by > y && side > 0) wound++;
+      else if (ay > y && by <= y && side < 0) wound--;
+    }
+  return wound;
+}
+
+function pointSegment(
+  px: number,
+  py: number,
+  ax: number,
+  ay: number,
+  bx: number,
+  by: number,
+) {
+  const dx = bx - ax,
+    dy = by - ay,
+    length = dx * dx + dy * dy;
+  const t =
+    length > 0
+      ? Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / length))
+      : 0;
+  return Math.hypot(px - ax - t * dx, py - ay - t * dy);
+}
+
+/** The distance between segments ab and cd, zero where they cross. */
+function segments(e: number[], f: number[]) {
+  const [ax, ay, bx, by] = e,
+    [cx, cy, dx, dy] = f;
+  const cross = (
+    px: number,
+    py: number,
+    qx: number,
+    qy: number,
+    rx: number,
+    ry: number,
+  ) => (qx - px) * (ry - py) - (qy - py) * (rx - px);
+  const d1 = cross(ax, ay, bx, by, cx, cy),
+    d2 = cross(ax, ay, bx, by, dx, dy),
+    d3 = cross(cx, cy, dx, dy, ax, ay),
+    d4 = cross(cx, cy, dx, dy, bx, by);
+  if (
+    ((d1 > 0 && d2 < 0) || (d1 < 0 && d2 > 0)) &&
+    ((d3 > 0 && d4 < 0) || (d3 < 0 && d4 > 0))
+  )
+    return 0;
+  return Math.min(
+    pointSegment(ax, ay, cx, cy, dx, dy),
+    pointSegment(bx, by, cx, cy, dx, dy),
+    pointSegment(cx, cy, ax, ay, bx, by),
+    pointSegment(dx, dy, ax, ay, bx, by),
+  );
+}
+
+/** The edges of a shape whose boxes come within `reach` of a box. */
+function edgesNear(shape: GlyphShape, box: number[], reach: number) {
+  const out: number[][] = [];
+  for (const c of shape.contours)
+    for (let k = 0; k < c.length; k += 2) {
+      const e = [c[k], c[k + 1], c[(k + 2) % c.length], c[(k + 3) % c.length]];
+      if (
+        Math.min(e[0], e[2]) <= box[2] + reach &&
+        Math.max(e[0], e[2]) >= box[0] - reach &&
+        Math.min(e[1], e[3]) <= box[3] + reach &&
+        Math.max(e[1], e[3]) >= box[1] - reach
+      )
+        out.push(e);
+    }
+  return out;
+}
+
+/** Whether the ink of two glyph shapes is apart by more than `margin` plus
+ * their chord errors. `budget.left` counts edge pairs; when it runs out, the
+ * answer is no. */
+export function inkApart(
+  a: GlyphShape,
+  b: GlyphShape,
+  margin: number,
+  budget: { left: number },
+): boolean {
+  const reach = a.error + b.error + margin;
+  if (!(reach >= 0)) return false;
+  const near = edgesNear(a, b.box, reach),
+    other = edgesNear(b, a.box, reach);
+  budget.left -= near.length * other.length;
+  if (budget.left < 0) return false;
+  for (const e of near)
+    for (const f of other) if (segments(e, f) <= reach) return false;
+  // Edges apart: the shapes are apart unless one holds the other.
+  for (const [inner, outer] of [
+    [a, b],
+    [b, a],
+  ])
+    for (const c of inner.contours)
+      if (winding(outer, c[0], c[1]) !== 0) return false;
+  return true;
+}
