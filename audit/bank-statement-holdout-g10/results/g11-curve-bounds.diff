+// would widen the box beyond the ink (BNK-PDF-1 G11). Anything unreadable
+// stays unknown, never small.
+const MOVE = 0,
+  CLOSE = 4,
+  PATH_POINTS = [2, 2, 6, 4, 0];
+const bezier = (p: readonly number[], t: number) => {
+  const u = 1 - t;
+  return p.length === 4
+    ? u * u * u * p[0] +
+        3 * u * u * t * p[1] +
+        3 * u * t * t * p[2] +
+        t * t * t * p[3]
+    : u * u * p[0] + 2 * u * t * p[1] + t * t * p[2];
+};
+/** One coordinate of a quadratic or cubic Bezier segment, from its start
+ * through its control points to its end, where its derivative is zero inside
+ * the segment. */
+function turns(p: readonly number[]): number[] {
+  // The derivative is proportional to a t² + b t + c.
+  const [a, b, c] =
+    p.length === 4
+      ? [
+          p[3] - 3 * p[2] + 3 * p[1] - p[0],
+          2 * (p[2] - 2 * p[1] + p[0]),
+          p[1] - p[0],
+        ]
+      : [0, p[2] - 2 * p[1] + p[0], p[1] - p[0]];
+  let roots: number[] = [];
+  if (a === 0) roots = b === 0 ? [] : [-c / b];
+  else {
+    const d = b * b - 4 * a * c;
+    // The stable pair of roots: no difference of nearly equal terms.
+    const q = d < 0 ? 0 : -(b + Math.sign(b || 1) * Math.sqrt(d)) / 2;
+    if (q !== 0) roots = [q / a, c / q];
+  }
+  return roots.filter((t) => t > 0 && t < 1).map((t) => bezier(p, t));
+}
