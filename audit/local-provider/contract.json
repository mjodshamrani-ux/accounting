{
  "version": 1,
  "classification": "frozen synthetic development experiment, not a holdout or field validation",
  "scope": "column meaning only; normalized native CSV text, not image/PDF interpretation",
  "frozenBeforeInference": true,
  "modelCountLimit": 1,
  "engineeringDaysLimit": 3,
  "perCaseTimeoutMs": 30000,
  "maxInputBytes": 8192,
  "maxNewTokens": 192,
  "generation": { "do_sample": false, "enable_thinking": false },
  "devices": {
    "actual": "Apple M5, 16 GiB RAM, macOS, Node CPU runtime",
